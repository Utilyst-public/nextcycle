{
  "name": "@workspace/nextcycle",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "predev": "node --import tsx scripts/release-data.mjs --no-images",
    "build": "node scripts/generate-brand-assets.mjs && node scripts/reconcile-qa.mjs && node --import tsx scripts/release-data.mjs && node --import tsx scripts/export-data-gaps-figure.mjs && tsc -p tsconfig.json && vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "preview": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "data:sample": "node scripts/generate-sample-data.mjs && npm run data:refresh",
    "data:refresh": "node scripts/reconcile-qa.mjs && node --import tsx scripts/release-data.mjs",
    "test": "node --import tsx --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.6",
    "html-to-image": "1.11.13",
    "lucide-react": "0.545.0",
    "maplibre-gl": "6.19.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "recharts": "2.15.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "22.18.8",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.0.4",
    "lighthouse": "13.0.1",
    "sharp": "0.34.5",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  }
}
